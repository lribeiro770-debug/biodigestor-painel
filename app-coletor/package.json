{
  "name": "biodigestor-coletor",
  "version": "1.0.0",
  "description": "Coletor do Biodigestor — app Android (Capacitor) que baixa os dados do ESP32 pelo Wi-Fi local e envia ao GitHub",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor": "node scripts/copiar-vendor.mjs",
    "sync": "npm run vendor && npx cap sync android",
    "test": "node --test test/*.test.js",
    "versao": "node -p \"require('./package.json').version\""
  },
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "6.2.1",
    "@capacitor/app": "6.0.2",
    "@capacitor/core": "6.2.1",
    "@capacitor/filesystem": "6.0.3",
    "@capacitor/network": "6.0.3",
    "@capacitor/preferences": "6.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1"
  },
  "engines": {
    "node": ">=18"
  }
}
